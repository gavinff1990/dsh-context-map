{
  "name": "dsh-context-map",
  "version": "0.1.1",
  "description": "把一段对话的上下文画成信息架构图:把目标、背景、决策、动作、产物、风险和待确认项整理成一张分层结构图,输出自包含 SVG、可缩放可搜索的 HTML 和 Mermaid Markdown。Turn a conversation's context into an information-architecture map: goals, background, decisions, actions, artifacts, risks and open questions in one layered diagram, exported as a self-contained SVG, an interactive searchable HTML page and Mermaid Markdown.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./render": "./lib/build.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-context-map": "./bin/cli.js"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Context Map",
    "summary": "把对话上下文画成信息架构图:目标、背景、决策、动作、产物、风险、待确认项分层成图,一键导出 SVG / 交互式 HTML / Mermaid。",
    "categories": [
      "可视化",
      "文档",
      "协作"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": [
        "tool:context_map"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    },
    "permissions": {
      "filesystem": [
        "workspace write: the map directory the model names (default <cwd>/.dsh-context-map)"
      ],
      "network": [],
      "process": []
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-pack",
    "context-map",
    "information-architecture",
    "diagram",
    "svg",
    "mermaid",
    "architecture",
    "visualization",
    "上下文",
    "架构图",
    "信息架构"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "demo": "node bin/cli.js examples/spec.json --out examples/out",
    "check": "node --check lib/index.js && node --check bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gavinff1990/dsh-context-map.git"
  },
  "homepage": "https://github.com/gavinff1990/dsh-context-map#readme",
  "bugs": {
    "url": "https://github.com/gavinff1990/dsh-context-map/issues"
  }
}
